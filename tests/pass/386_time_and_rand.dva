// Standard library `time` and `rand` modules:
// - Single-call date/time formatting (`time::iso!`, `time::utc_iso!`,
//   `time::date!`, `time::clock!`, `time::format(...)`)
// - Polymorphic dispatch on `()` (via `!`), `Int` epoch seconds, and `DateTime`
// - Deterministic & auto-seeded `rand::Rng`, global `rand::*`, and smooth noise

#use io
#use time
#use rand

// 1. Deterministic UTC timestamp & DateTime formatting
ts = 1793414400
io::out $ time::utc_iso(ts)
io::out $ time::utc_date(ts)
io::out $ time::utc_clock(ts)

dt = time::utc(ts)
io::out $ (dt.year, dt.month, dt.day, dt.hour, dt.min, dt.sec, dt.weekday, dt.yearday)
io::out $ time::utc_iso(dt)
io::out $ time::utc_format("%a, %d %b %Y %H:%M:%S %Z", dt)
io::out $ time::epoch(dt)

// 2. Leap year and days in month
io::out $ (time::is_leap_year(2024), time::is_leap_year(2026), time::days_in_month(2024, 2), time::days_in_month(2026, 2))

// 3. Single-call current time (`!`) sanity checks
s_iso  = time::iso!
s_uiso = time::utc_iso!
s_date = time::date!
s_clk  = time::clock!
s_fmt  = time::format("%Y-%m-%d")
io::out $ (?s_iso == 25, ?s_uiso == 20, ?s_date == 10, ?s_clk == 8, s_date == s_fmt)

// 4. Deterministic PRNG (`rand::new(seed)` and `rand::srand(seed)`)
rng1 = rand::new(42)
rng2 = rand::seed(42)
a1 = rand::range(rng1, 10, 100)
a2 = rand::range(rng2, 10, 100)
b1 = rand::inclusive(rng1, 1, 6)
b2 = rand::inclusive(rng2, 1, 6)
io::out $ (a1 == a2, b1 == b2, a1 !< 10 && a1 < 100, b1 !< 1 && b1 !> 6)

rand::srand(12345)
g1 = rand::int(1000)
g2 = rand::between(10, 20)
rand::srand(12345)
h1 = rand::int(1000)
h2 = rand::between(10, 20)
io::out $ (g1 == h1, g2 == h2, g2 !< 10 && g2 !> 20)

// 5. Stateless noise bounds
n1 = rand::noise1d(1.25, 7)
f1 = rand::fbm1d(1.25, 7)
n2 = rand::noise2d(1.25, 2.75, 7)
io::out $ (n1 !< -1.0 && n1 !> 1.0, f1 !< -1.0 && f1 !> 1.0, n2 !< -1.0 && n2 !> 1.0)
