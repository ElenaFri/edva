// tests/pass/312_std_ccl.dva
// Comprehensive tests for std/ccl parser, model, deterministic serializer,
// and structural #! encode / decode.

#use io
#use str
#use ccl

#type LogMode <
   Quiet
   Custom(String)
   Level(Int)
>

#type ServerCfg (
   host: String = "127.0.0.1"
   port: Int = 8080
   tls: <> = <->
   cert_path: <String|>
   tags: String{}
   env: String ^ String
   mode: LogMode = LogMode(Quiet)
)

#type StrictCfg (
   name: String
   retries: Int = 3
)

#type Pair (Int, String)

main: () => ()
main = !=>
   // 1. Basic CCL parsing & query helpers
   src1 = "key1 = hello\n" +
      "/= this is a comment\n" +
      "key2 = world = 123\n" +
      "list =\n" +
      "  = banana\n" +
      "  = apple\n" +
      "server =\n" +
      "  host = 127.0.0.1\n" +
      "  port = 8080\n" +
      "desc =\n" +
      "  line one\n" +
      "  line two\n"

   p1 = ccl::parse(src1, "test1.ccl")
   p1
      | doc1 =>
         io::out("--- test 1: parsing ---")
         io::out(ccl::has(doc1, "key1"))
         io::out(ccl::has(doc1, "missing"))
         io::out(ccl::count(doc1, "key1"))
         io::out(ccl::get(doc1, "key1") | s => s | "")
         io::out(ccl::get(doc1, "key2") | s => s | "")

         opt_list = ccl::get_list(doc1, "list")
         opt_list
            | l =>
               io::out(?l)
               io::out(l(0) | _ | "")
               io::out(l(1) | _ | "")
            | io::out("list not found")

         opt_sec = ccl::get_section(doc1, "server")
         opt_sec
            | sec =>
               io::out(ccl::get(sec, "host") | s => s | "")
               io::out(ccl::get(sec, "port") | s => s | "")
            | io::out("server section not found")

         io::out(ccl::get(doc1, "desc") | s => s | "")
      | e =>
         io::out("parse error:")
         io::out(e.msg)

   // 2. Structural #! encode and decode on records, options, arrays, maps, enums
   io::out("--- test 2: structural encode & decode ---")
   cfg = ServerCfg.zero
   cfg.host = "0.0.0.0"
   cfg.port = 9090
   cfg.tls = <+>
   cfg.cert_path = <+ "/etc/ssl/cert.pem" +>
   cfg.tags += "api"
   cfg.tags += "prod"
   cfg.env ^ "RUST_LOG" = "info"
   cfg.mode = LogMode(Custom, "json")

   encoded = ccl::encode(cfg)
   dec_res = ccl::decode(ServerCfg, encoded)
   dec_res
      | c2 =>
         io::out(c2.host)
         io::out(c2.port)
         io::out(c2.tls)
         io::out(c2.cert_path | p => p | "none")
         io::out(?c2.tags)
         io::out(c2.tags(0) | _ | "")
         io::out(c2.tags(1) | _ | "")
         io::out(c2.env ^ "RUST_LOG" | v => v | "")
         c2.mode
            [Quiet] io::out("mode:quiet")
            [Custom s] io::out("mode:custom:" + s)
            [Level n] io::out("mode:level:" + str::from_int(n))
         io::out(ccl::encode(c2) == encoded)
      | e =>
         io::out("decode failed: " + e.msg)

   // 3. Forward-compatible decoding: defaults, <--> options, empty containers, unknown keys ignored
   io::out("--- test 3: defaults & forward compatibility ---")
   minimal_ccl = "port = 3000\nunknown_future_key = ignored\nmode = Quiet\n"
   d_min = ccl::decode(ServerCfg, minimal_ccl)
   d_min
      | c3 =>
         io::out(c3.host)
         io::out(c3.port)
         io::out(c3.tls)
         io::out(c3.cert_path | p => p | "none")
         io::out(?c3.tags)
         c3.mode
            [Quiet] io::out("mode:quiet")
            [Custom s] io::out("mode:custom:" + s)
            [Level n] io::out("mode:level:" + str::from_int(n))
      | e =>
         io::out("minimal decode failed: " + e.msg)

   // 4. Error cases: missing required field, invalid int, unknown enum variant
   io::out("--- test 4: decode errors ---")
   e1 = ccl::decode(StrictCfg, "retries = 5\n")
   e1
      | io::out("unexpected success")
      | err => io::out(err.msg)

   e2 = ccl::decode(StrictCfg, "name = app\nretries = not_an_int\n")
   e2
      | io::out("unexpected success")
      | err => io::out(err.msg)

   e3 = ccl::decode(ServerCfg, "mode = UnknownVariant\n")
   e3
      | io::out("unexpected success")
      | err => io::out(err.msg)

   // 5. Tuple and CclDoc target decoding
   io::out("--- test 5: tuple & CclDoc ---")
   tup = (42, "answer")
   tup_ccl = ccl::encode(tup)
   d_tup = ccl::decode(Pair, tup_ccl)
   d_tup
      | t2 =>
         io::out(t2.0)
         io::out(t2.1)
      | err => io::out("tuple decode err: " + err.msg)

   d_doc = ccl::decode(ccl::CclDoc, "a = 1\nb = 2\n")
   d_doc
      | doc =>
         io::out(ccl::get(doc, "a") | s => s | "")
         io::out(ccl::get(doc, "b") | s => s | "")
      | err => io::out("doc decode err: " + err.msg)

   io::out("--- done ---")

main!
