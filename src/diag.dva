// src/diag.dva — centralized compiler diagnostic error messages (#114)
// Keep repeated diagnostic text here, including text shared by typed and
// untyped compiler paths. Callers supply names, type descriptions, error
// codes, and source locations. Runtime messages retain their code and newline.
// This leaf module must not depend on lexer, parser, type checker, or codegen.

#public

E1017_multiline_under_indented: () => String
E1017_multiline_under_indented = !=> "Line indented less than first line in multi-line string"

E1018_multiline_unterminated: () => String
E1018_multiline_unterminated = !=> "Unterminated multi-line string literal -- missing closing '\"'"

E1017_heredoc_under_indented: () => String
E1017_heredoc_under_indented = !=> E1017_multiline_under_indented!

E1018_heredoc_unterminated: () => String
E1018_heredoc_unterminated = !=> E1018_multiline_unterminated!

E2024_bare_bar_position: () => String
E2024_bare_bar_position = !=>
   "Bare '|' is only allowed as the first branch (Left Value) or final " +
   "branch (catch-all) in a choice expression."

E2025_range_endpoint_whitespace: () => String
E2025_range_endpoint_whitespace = !=> "Whitespace between range endpoint and '..' is forbidden."

E2032_call_paren_whitespace: () => String
E2032_call_paren_whitespace = !=> "Whitespace before call parenthesis is forbidden."

E2037_params_parenthesized: () => String
E2037_params_parenthesized = !=>
   "Function parameters may not be parenthesized; write 'x, y =>' with no parentheses."

E2039_expr_too_deep: () => String
E2039_expr_too_deep = !=> "Expression nested too deeply"

param_mutable: String => String
param_mutable = name =>
   "Function parameters cannot be mutable — remove prime suffix from '${name}'."

E2040_underscore_param: () => String
E2040_underscore_param = !=>
   "Explicit '_' parameter is forbidden in function parameter lists — use a named parameter or omit unused binders."

E2044_underscore_assign: () => String
E2044_underscore_assign = !=>
   "Cannot assign to '_' — '_' cannot be used as an assignment target."

E2093_assign_typed_load: () => String
E2093_assign_typed_load = !=>
   "Cannot assign to a typed load; write through the untyped '@[addr]' form instead."

E2096_bar_before_guard: () => String
E2096_bar_before_guard = !=>
   "A '|' before a '[' guard is invalid — chain guarded branches adjacently."

E2105_redundant_choice_tail: () => String
E2105_redundant_choice_tail = !=> "Redundant choice tail '<+> | <->' is forbidden. " +
   "Empty guard body '[guard]' already produces a bare flag."

E2108_state_binding_target: () => String
E2108_state_binding_target = !=>
   "State binding operator '~~' requires a variable, member access, or indexed element target."

E2109_disallowed_variant_wildcard: String => String
E2109_disallowed_variant_wildcard = tag =>
   "Disallowed syntax '[${tag} _]'. Use '[${tag}]' instead."

E3003_choice_underscore_undefined: () => String
E3003_choice_underscore_undefined = !=>
   "Omitting a Choice/pattern branch's leading condition is only allowed when " +
   "'_' is already defined in the enclosing scope (e.g. inside a '=> '-omitted-param " +
   "lambda, or a cycle body). '_' is not defined here."

E3008_not_invalid_type: () => String
E3008_not_invalid_type = !=>
   "Unary '!' cannot be applied to this type. Use Flag for logical NOT or '+' for Builder freeze."

E3187_not_integer: () => String
E3187_not_integer = !=> "Unary '!' cannot be applied to an integer. " +
   "To create a Builder with capacity n, use the brace literal '{n}'."

assign_void_variable: String => String
assign_void_variable = name => "Cannot assign Void expression to variable '${name}'."

assign_void_element: String => String
assign_void_element = name => "Cannot assign Void expression to element of '${name}'."

whole_value_init: String => String
whole_value_init = name =>
   "Homogeneous record '${name}' requires whole-value initialization before element access."

record_default_missing: String, String => String
record_default_missing = field, record =>
   "Field '${field}' of '${record}' has no default value and was not provided."

enum_no_variant: String, String => String
enum_no_variant = name, label =>
   "Enum '${name}' has no variant labeled '${label}'."

enum_unit_payload: String, String => String
enum_unit_payload = name, label =>
   "Enum '${name}' variant '${label}' is a bare unit and takes no payload argument."

enum_payload_type: String, String, String, String => String
enum_payload_type = name, label, expected, got =>
   "Enum '${name}' variant '${label}' expects payload of type ${expected}, got ${got}."

partial_composite_argument: String => String
partial_composite_argument = name =>
   "Passing a partially-initialized composite '${name}' to a function is disallowed."

E3051_dynamic_index_hetero: () => String
E3051_dynamic_index_hetero = !=> "Dynamic indexing is only allowed on homogeneous records."

E3195_cycle_iter_hetero: () => String
E3195_cycle_iter_hetero = !=> "Cycle iteration is only allowed on homogeneous records."

E3065_rawptr_to_string: () => String
E3065_rawptr_to_string = !=>
   "Cannot construct a String from a RawPtr — 'String(ptr)' is rejected. " +
   "Build with literals, '+', '++', 's + n', or a Builder."

E3078_addr_builder_or_string: () => String
E3078_addr_builder_or_string = !=> "Address operator '&' requires a Builder or String operand."

E3182_record_size_mismatch: () => String
E3182_record_size_mismatch = !=> "Record size mismatch in arithmetic"

E3183_arithmetic_type_mismatch: () => String
E3183_arithmetic_type_mismatch = !=> "Arithmetic type mismatch"

E3184_builder_append_type: () => String
E3184_builder_append_type = !=> "Builder append requires byte or String"

E3185_choice_branch_mismatch: () => String
E3185_choice_branch_mismatch = !=> "Incompatible branch result types in choice"

E3091_propagate_ram_operand: () => String
E3091_propagate_ram_operand = !=> "Operand of '--!' must be a ramification"

E3103_cannot_infer_type: () => String
E3103_cannot_infer_type = !=> "Cannot infer concrete type for expression"

reassign_immutable: String => String
reassign_immutable = name =>
   "Cannot re-assign immutable binding '${name}'. Use a prime suffix ('${name}'') for rebindable variables."

E3133_addr_escape_restore: () => String
E3133_addr_escape_restore = !=> "Cannot return Addr from an arena-restore scope. " +
   "Copy data explicitly with '++' before boundary."

E3134_addr_escape_lifecycle: () => String
E3134_addr_escape_lifecycle = !=>
   "Assignment of block-scoped Addr to outer-scope binding escapes arena lifecycle."

E3136_type_choice_no_branch: () => String
E3136_type_choice_no_branch = !=> "Compile-time type choice has no branch for this type."

E3140_no_runtime_arena: () => String
E3140_no_runtime_arena = !=>
   "arena allocation under --no-runtime. The feature you used (a record, closure, " +
   "String concat, Builder, or heap ram/enum) needs the runtime arena, " +
   "which --no-runtime omits. Use only bare-metal features: Int arithmetic, " +
   "String literals, '?s', 's(i)', and raw '@[Addr(...)]' memory."

E3142_raw_write_type: () => String
E3142_raw_write_type = !=>
   "Raw memory write '@[addr] = expr' requires an integerish or pointer value, got Float"

E3150_view_escape_frame: () => String
E3150_view_escape_frame = !=> "View cannot escape function frame"

E3172_exit_status_integerish: () => String
E3172_exit_status_integerish = !=> "'#exit' expects an integerish status code"

E3173_return_outside_fn: () => String
E3173_return_outside_fn = !=> "Return '--|' can only be used inside a function."

E3193_propagate_outside_fn: () => String
E3193_propagate_outside_fn = !=> "Propagate operator '--!' can only be used inside a function."

E3175_choice_const_discarded: () => String
E3175_choice_const_discarded = !=>
   "Choice has a constant expression in a branch and its value is discarded"

// Shared text fragments retain caller-specific names, types, and source locations.

uninitialized_variable: String => String
uninitialized_variable = name => "Use of uninitialized variable '${name}'."

uninitialized_load: String => String
uninitialized_load = name =>
   "Use of uninitialized variable '${name}' — a forward annotation ('name: Type') " +
   "allocates no storage; assign a value before reading."

reserved_type_name: String => String
reserved_type_name = name =>
   "Cannot define '${name}' — it is a built-in type name and is reserved for type coercion."

return_type_mismatch: String => String
return_type_mismatch = name => "Return type mismatch in function: ${name}"

assignment_type_mismatch: String => String
assignment_type_mismatch = name => "Type mismatch in assignment to: ${name}"

member_index_constant: () => String
member_index_constant = !=>
   "Member index 'x.(i)' must be a compile-time constant (a per-field cycle index)."

field_assignment_type_mismatch: String => String
field_assignment_type_mismatch = field =>
   "Type mismatch in field assignment: ${field}"

string_write: String => String
string_write = fn =>
   "Cannot write through a String call-target '${fn}(...)' — Strings are immutable " +
   "and a Builder is written with 'b + c'."

slice_write: String => String
slice_write = fn =>
   "Cannot write element of forward-annotated slice '${fn}' before whole-value initialization."

return_type_inference: String => String
return_type_inference = name =>
   "Cannot infer concrete return type for function '${name}'"

function_value_signature: String => String
function_value_signature = name =>
   "Function '${name}' is used as a value but its parameter types cannot be " +
   "determined — no declared signature and no call site to infer from. " +
   "Declare a signature: '${name}: T1, T2 => R'."

expected_primary: String => String
expected_primary = text => "Expected primary expression, got '${text}'"

cycle_jump_depth: String => String
cycle_jump_depth = text =>
   "Cycle jump suffix must be a positive integer depth (e.g. '-->2'), got '${text}'"

record_repeat_count: String => String
record_repeat_count = text =>
   "Record type repetition count must be a positive integer, got '${text}'"

record_repeat_limit: Int => String
record_repeat_limit = n =>
   "Record type repetition count ${n} exceeds the maximum of 1000000"

repetition_count_limit: Int => String
repetition_count_limit = n =>
   "Repetition count ${n} exceeds the maximum of 1000000"

infix_right_binding_power: Int, String => String
infix_right_binding_power = lbp, text =>
   "Expected an integer right binding-power after '#infix ${lbp}', got '${text}'."

infix_left_binding_power: String => String
infix_left_binding_power = text =>
   "Expected an integer left binding-power after '#infix', got '${text}'."

name_clash_imported: String, String, String => String
name_clash_imported = bare, from, src =>
   "E3033: Name clash: symbol '${bare}' imported from '${from}' conflicts with " +
   "symbol already imported from '${src}'"

name_clash_foreign_imported: String, String, String => String
name_clash_foreign_imported = bare, from, src =>
   "E3033: Name clash: foreign function '${bare}' imported from '${from}' " +
   "conflicts with symbol already imported from '${src}'"

name_clash_declared: String, String => String
name_clash_declared = bare, src =>
   "E3033: Name clash: symbol '${bare}' declared in module conflicts with " +
   "symbol imported from '${src}'"

name_clash_foreign_declared: String, String => String
name_clash_foreign_declared = bare, src =>
   "E3033: Name clash: foreign function '${bare}' declared in module conflicts " +
   "with symbol imported from '${src}'"

package_import_cycle: String => String
package_import_cycle = chain =>
   "E5038: module import cycle across packages: ${chain}"

clang_compilation_failed: Int, Int => String
clang_compilation_failed = code, exit_code =>
   "E${code}: Clang compilation failed with exit code ${exit_code}"

E5007_no_input: () => String
E5007_no_input = !=> "E5007: No input .dva file specified."

E3186_open_record_fields: () => String
E3186_open_record_fields = !=> "Record does not satisfy open record fields"

ram_shape_mismatch: String, String => String
ram_shape_mismatch = from, to =>
   "Cannot assign ramification of shape ${from} to ${to}"

ram_shape_assign_mismatch: String, String, String => String
ram_shape_assign_mismatch = shape, name, declared =>
   "Cannot assign ramification of shape ${shape} to '${name}' (declared as ${declared})."

locked_manifest_stale: String => String
locked_manifest_stale = what =>
   "--locked: edva.lock.ccl is out of date (${what} changed)"

repository_illegal_path: String => String
repository_illegal_path = alias =>
   "dependency '${alias}': repository contains illegal path or escaping symlink"

vendor_tree_mismatch: String, String, String => String
vendor_tree_mismatch = alias, expected, got =>
   "tampered vendor content: tree hash mismatch for '${alias}' " +
   "(expected ${expected}, got ${got})"

archive_illegal_path: String => String
archive_illegal_path = alias =>
   "dependency '${alias}': archive contains illegal path or path traversal"

ram_ordering: String => String
ram_ordering = op =>
   "Operator '${op}' cannot be applied to ramifications — ramifications have no " +
   "ordering; test their slots with '|' branches instead."

enum_ordering: String => String
enum_ordering = op =>
   "Operator '${op}' cannot be applied to enums — enums have no ordering; match " +
   "their variants with '[Variant]' branches instead."

record_field_index_constant: () => String
record_field_index_constant = !=>
   "Record field index 'T.(i)' must be a compile-time constant (a per-field cycle index)."

enum_variant_index_constant: () => String
enum_variant_index_constant = !=>
   "Enum variant index 'T.(i)' must be a compile-time constant (a per-variant cycle " +
   "index)."

E4002_string_length_overflow: () => String
E4002_string_length_overflow = !=>
   "E4002: string length overflow (concatenation exceeds 64-bit capacity)\n"

cycle_jump_level: String, Int, Int => String
cycle_jump_level = op, level, depth =>
   "'${op}' targets cycle-nesting level ${level}, but only ${depth} " +
   "enclosing cycle(s) exist at this point."

E4007_unwrap_empty_or_error: () => String
E4007_unwrap_empty_or_error = !=> "E4007: unwrap on empty or error ramification\n"

compile_time_parameter: String => String
compile_time_parameter = ct =>
   "Compile-time parameter '${ct}' is not compile-time evaluable"

enum_label_ambiguous: String => String
enum_label_ambiguous = label =>
   "Enum label '${label}' is ambiguous — declared by multiple enums; " +
   "qualify the variant as 'Enum::${label}'."

E4008_builder_length_bounds: () => String
E4008_builder_length_bounds = !=> "E4008: Builder length assignment out of bounds\n"

runtime_error_format: () => String
runtime_error_format = !=> "Error %lld: %.*s\n  at %.*s:%lld:%lld\n"

E4004_arena_allocation_too_large: () => String
E4004_arena_allocation_too_large = !=>
   "E4004: arena allocation too large for a single chunk (requested %llu bytes, chunk " +
   "cap %llu bytes)\n"

E4003_arena_chunk_limit: () => String
E4003_arena_chunk_limit = !=> "E4003: arena chunk limit reached (too many arena chunks)\n"

E4001_arena_exhausted: () => String
E4001_arena_exhausted = !=> "E4001: arena allocator exhausted (out of memory)\n"

write_ir_failed: String => String
write_ir_failed = path => "E5012: Failed to write LLVM IR to '${path}'"

write_ir_failed_reason: String, String => String
write_ir_failed_reason = path, err =>
   "E5012: Failed to write LLVM IR to '${path}': ${err}"

E1008_string_unterminated: () => String
E1008_string_unterminated = !=> "Unterminated string literal -- missing closing '\"'"

// --- Diagnostic Code Registry -----------------------------------------------
// DiagCode is the typed registry of front-end diagnostic codes (lexer E1xxx,
// parser E2xxx, type checker E3xxx). One code = one cause: a code reused for
// distinct causes must be split. code_int maps a code to the numeric
// identifier used in output, structured capture (LSP), and DiagEntry.

#type DiagCode <
   E1001
   E1002
   E1003
   E1004
   E1007
   E1008
