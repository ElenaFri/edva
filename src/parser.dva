// src/parser.dva — Facade for modular parser units.
//
// The parser is split into src/parser/*.dva (pstate, pexpr, plambda, ptype,
// ppost, pchoice, pident); this module re-exports the public parsing API
// consumed by the driver, formatter, and LSP.

#use "ast"

#use "parser/pstate"
#use "parser/pexpr"
#use "parser/plambda"
#use "parser/ptype"
#use "parser/ppost"
#use "parser/pchoice"
#use "parser/pident"

#public

#type Parser pstate::Parser

set_target_triple: String => ()
set_target_triple = t => pstate::set_target_triple(t)

parse_init: String => Parser
parse_init = src => pexpr::parse_init(src)

parser_set_file: Parser, String => ()
parser_set_file = p, file => pstate::parser_set_file(p, file)

parse_program: Parser => <ast::Expr|>
parse_program = p => plambda::parse_program(p)

fold_program_consts: ast::Exprs => ast::Exprs
fold_program_consts = exprs => pident::fold_program_consts(exprs)

last_segment: String => String
last_segment = p => ptype::last_segment(p)
