// net module for Dva
// POSIX socket helpers with compile-time target OS selection (#! os) for
// struct layouts (Addrinfo) and numeric constants (AF_*, SO_*, SOL_SOCKET,
// O_NONBLOCK).
//
// Error convention: the socket helpers return `<T | String>` rams — positive
// = the value, negative = a short human-readable message ("socket failed",
// "connect failed") the caller may inspect and handle gracefully. This is the
// *recoverable* regime; the poisonous structural `Error` (which aborts on
// unwrap) is used by std/json.dva instead.
// See M8 in process/codebase_review.md.

#use libc
#use str
#use sys

#public
   // Addr family constants
   AF_INET  = 2
   AF_INET6 = #! (os ["darwin"] 30 | 10)

   // Socket type constants
   SOCK_STREAM = 1
   SOCK_DGRAM  = 2

   // Protocol
   IPPROTO_TCP  = 6
   IPPROTO_UDP  = 17
   IPPROTO_IPV6 = 41

   // TCP / IPv6 options
   TCP_NODELAY = 1
   IPV6_V6ONLY = #! (os ["darwin"] 27 | 26)

   // SOL_SOCKET / SO_REUSEADDR / SO_REUSEPORT / SO_*TIMEO
   SOL_SOCKET   = #! (os ["darwin"] 0xFFFF | 1)
   SO_REUSEADDR = #! (os ["darwin"] 4 | 2)
   SO_REUSEPORT = #! (os ["darwin"] 0x0200 | 15)
   SO_RCVTIMEO  = #! (os ["darwin"] 4102 | 20)
   SO_SNDTIMEO  = #! (os ["darwin"] 4101 | 21)

   // fcntl command / flag
   F_GETFL     = 3
   F_SETFL     = 4
   O_NONBLOCK  = #! (os ["darwin"] 4 | 2048)

   // Platform-resolved socket constants and sockaddr_in sin_family field
   sin_fam_inet: () => u16
   sin_fam_inet = !=> u16(#! (os ["darwin"] ((AF_INET .<. 8) .|. 16) | AF_INET))

   sol_socket: () => Int
   sol_socket = !=> SOL_SOCKET

   so_reuseaddr: () => Int
   so_reuseaddr = !=> SO_REUSEADDR

   so_rcvtimeo: () => Int
   so_rcvtimeo = !=> SO_RCVTIMEO

   so_sndtimeo: () => Int
   so_sndtimeo = !=> SO_SNDTIMEO

   // shutdown "how"
   SHUT_WR = 1

   // IPv4 in_addr layout (4 bytes)
   #type InAddr #packed (
      b0: u8,
      b1: u8,
      b2: u8,
      b3: u8,
   )

   // sockaddr_in layout (16 bytes, matches struct sockaddr_in on Linux x86_64)
   #type SockAddrIn #packed (
      sin_family: u16,
      sin_port:   u16,
      sin_addr:   InAddr,
      sin_zero:   u64,
   )

   // sockaddr_in6 layout (28 bytes, matches struct sockaddr_in6)
   #type SockAddrIn6 #packed (
      sin6_family:   u16,
      sin6_port:     u16,
      sin6_flowinfo: u32,
      sin6_addr_hi:  u64,
      sin6_addr_lo:  u64,
      sin6_scope_id: u32,
   )

   // struct timeval for SO_RCVTIMEO/SO_SNDTIMEO.
   #type Timeval (
      tv_sec:  i64,
      tv_usec: i64,
   )

   // struct addrinfo (Linux vs Darwin: ai_addr and ai_canonname are swapped):
   // getaddrinfo result list node.
   #type AddrinfoLinux (
      ai_flags:     i32,
      ai_family:    i32,
      ai_socktype:  i32,
      ai_protocol:  i32,
      ai_addrlen:   i32,
      ai_pad:       i32,
      ai_addr:      Addr,
      ai_canonname: Addr,
      ai_next:      Addr,
   )

   #type AddrinfoDarwin (
      ai_flags:     i32,
      ai_family:    i32,
      ai_socktype:  i32,
      ai_protocol:  i32,
      ai_addrlen:   i32,
      ai_pad:       i32,
      ai_canonname: Addr,
      ai_addr:      Addr,
      ai_next:      Addr,
   )

   #type Addrinfo #! (os ["darwin"] AddrinfoDarwin | AddrinfoLinux)

   // struct ifaddrs for network interface enumeration
   #type IfAddrs (
      ifa_next:    Addr,
      ifa_name:    Addr,
      ifa_flags:   i32,
      ifa_pad:     i32,
      ifa_addr:    Addr,
      ifa_netmask: Addr,
      ifa_ifu:     Addr,
      ifa_data:    Addr,
   )

   // Result rams. The socket/data-returning helpers use these instead of
   // -1 / ""
   // sentinels, so callers pattern-match with '|' branches:
   //   Conn  < Int | String >      positive = fd, negative = error message
   //   Host  < Addr | String >  positive = addrinfo list, negative = error
   //   Chunk < String | >          positive = received data, negative = none
   #type Conn  < Int | String >
   #type Host < Addr | String >
   #type Chunk < String | >

   // Sign-extend a 32-bit C `int` return value from `libc` into 64-bit `Int`.
   c_int: Int => Int
   c_int = x => Int(i32(x))

   // Endian byte-swap helpers using LLVM intrinsics (%bswap).
   htons: Int => Int
   htons = x => %bswap(x) .>. 48

   ntohs: Int => Int
   ntohs = x => %bswap(x) .>. 48

   htonl: Int => Int
   htonl = x => %bswap(x) .>. 32

   ntohl: Int => Int
   ntohl = x => %bswap(x) .>. 32

   // Convert 32-bit integer IPv4 to InAddr
   in_addr_u32: Int => InAddr
   in_addr_u32 = v =>
      InAddr(
         u8(v .&. 0xFF),
         u8((v .>. 8) .&. 0xFF),
         u8((v .>. 16) .&. 0xFF),
         u8((v .>. 24) .&. 0xFF)
      )

   // Default zero InAddr (0.0.0.0 / INADDR_ANY)
   in_addr_any: () => InAddr
   in_addr_any = !=>
      InAddr(0u8, 0u8, 0u8, 0u8)

   // Parse a strict dotted-quad IPv4 address "a.b.c.d" into a 32-bit integer in
   // network byte order (little-endian [b0, b1, b2, b3]).
   parse_ipv4: String => < Int | >
   parse_ipv4 = s =>
      slen = ?s
      slen == 0 |-->
      parts = Int{}
      cur' = 0
      has_digit' = <->
      slen @ i =>
         c = s(i)
         c == '.'
            |
               !has_digit' | -->
               parts += cur'
               cur' = 0
               has_digit' = <->
            |
               !str::is_digit(c) | -->
               has_digit' = <+>
               cur' = cur' * 10 + (c - '0')
               cur' > 255 | (has_digit' = <->; -->)
      !has_digit' |-->
      parts += cur'
      ?parts != 4 |-->
      b0 = parts(0)!!
      b1 = parts(1)!!
      b2 = parts(2)!!
      b3 = parts(3)!!
      (b0 > 255 || b1 > 255 || b2 > 255 || b3 > 255) |-->
      <+ b0 .|. (b1 .<. 8) .|. (b2 .<. 16) .|. (b3 .<. 24) +>

   // Open a TCP client socket connected to host:port. Host may be a numeric IP
   // or a DNS name (resolved via getaddrinfo).
   // Returns Conn: <+ fd +> on success,
   // <- error -> on failure.
   tcp_connect: String, Int => Conn
   tcp_connect = host, port =>
      ip = libc::inet_addr $ host
      ip [< 0] --| net::tcp_connect_name(host, port)
      ip [0xFFFFFFFF] --| net::tcp_connect_name(host, port)
      sock = c_int(libc::socket(net::AF_INET, net::SOCK_STREAM, net::IPPROTO_TCP))
      sock [< 0] --| Conn(<- "socket failed" +>)
      addr = SockAddrIn(net::sin_fam_inet!,
         u16(htons $ port), in_addr_u32(ip), 0u64)
      ret = c_int(libc::connect(sock, &addr, 16))
      ret [0]
         Conn(<+ sock ->)
      |
         net::close_fd(sock)
         Conn(<- "connect failed" +>)

   // Connect to a host by DNS name (or numeric IP) via getaddrinfo. Walks the
   // resolver's result list (IPv4/IPv6, and any duplicate addresses) and tries
   // each until one connects.
   tcp_connect_name: String, Int => Conn
   tcp_connect_name = host, port =>
      list = net::resolve(host, port)
      list
         | l => net::walk_connect(l)
         | err => Conn(<- err +>)

   // Walk an addrinfo list (from resolve) trying each entry until one connects.
   // The list is freed before returning. Extracted as a top-level helper so the
   // lambda branch of tcp_connect_name stays a single expression
   // (a nested choice
   // inside a lambda branch is not parseable).
   walk_connect: Addr => Conn
   walk_connect = l =>
      cur' = l
      res' = -1
      0.. @
         Int(cur') [0] -->
         ai = Addrinfo(cur')
         cur' = ai.ai_next
         ai.ai_socktype != 1
            | --^
         sock = libc::socket(ai.ai_family, ai.ai_socktype, ai.ai_protocol)
         sock < 0
            | --^
         ret = libc::connect(sock, ai.ai_addr, ai.ai_addrlen)
         ret [0]
            res' = sock
            -->
         net::close_fd(sock)
      libc::freeaddrinfo(l)
      res' [< 0] Conn(<- "connect failed" +>) | Conn(<+ res' ->)

   // Resolve host:port into an addrinfo list (must be released with
   // libc::freeaddrinfo). Returns Host: <+ list +> on success, <- error -> on
   // failure.
   resolve: String, Int => Host
   resolve = host, port =>
      port_str = str::from_int(port)
      out = 0
      gai = libc::getaddrinfo(host, port_str, sys::addr_null, &out)
      gai [0]
         Host(<+ Addr(out) ->)
      |
         Host(<- "resolve failed" +>)

   // Create a TCP server socket bound to port and listening.
   // SO_REUSEADDR is set so a port can be re-bound immediately after a restart
   // (otherwise lingering TIME_WAIT connections block the bind for a while).
   // Returns Conn: <+ fd +> on success, <- error -> on failure.
   tcp_listen: Int, Int => Conn
   tcp_listen = port, backlog =>
      sock = c_int(libc::socket(net::AF_INET, net::SOCK_STREAM, net::IPPROTO_TCP))
      sock [< 0] --| Conn(<- "socket failed" +>)
      one = 1i32
      libc::setsockopt(sock, net::sol_socket!, net::so_reuseaddr!, &one, 4)
      addr = SockAddrIn(net::sin_fam_inet!,
         u16(htons $ port), in_addr_any!, 0u64)
      ret_b = c_int(libc::bind(sock, &addr, 16))
      ret_l = ret_b [0] c_int(libc::listen(sock, backlog)) | -1
      ret_l [0]
         Conn(<+ sock ->)
      |
         net::close_fd(sock)
         Conn(<- "bind/listen failed" +>)

   // Probe whether an IPv4 address:port can be bound WITHOUT SO_REUSEPORT.
   // Fails if any existing TCP_LISTEN socket (including SO_REUSEPORT) is bound to ip_addr:port.
   probe_ipv4: Int, Int => <>
   probe_ipv4 = ip_addr, port =>
      sock = c_int(libc::socket(net::AF_INET, net::SOCK_STREAM, 0))
      sock < 0 |->
      one = 1i32
      libc::setsockopt(sock, net::sol_socket!, net::so_reuseaddr!, &one, 4)
      addr = SockAddrIn(net::sin_fam_inet!, u16(htons(port)), in_addr_u32(ip_addr), 0u64)
      rc = c_int(libc::bind(sock, &addr, 16))
      libc::close(sock)
      rc == 0

   // Probe whether an IPv6 address:port ([::1] or [::]) can be bound WITHOUT SO_REUSEPORT.
   probe_ipv6: Int, <> => <>
   probe_ipv6 = port, is_loopback =>
      sock = c_int(libc::socket(net::AF_INET6, net::SOCK_STREAM, 0))
      sock < 0 |+>
      one = 1i32
      libc::setsockopt(sock, net::sol_socket!, net::so_reuseaddr!, &one, 4)
      libc::setsockopt(sock, net::IPPROTO_IPV6, net::IPV6_V6ONLY, &one, 4)
      addr_lo = is_loopback | (1u64 .<. 56) | 0u64
      addr6 = SockAddrIn6(u16(net::AF_INET6), u16(htons(port)), 0u32, 0u64, addr_lo, 0u32)
      rc = c_int(libc::bind(sock, &addr6, 28))
      libc::close(sock)
      rc == 0

   // Ensure no existing TCP listener (IPv4, wildcard, IPv6, or SO_REUSEPORT) is
   // already occupying the target port before workers bind with SO_REUSEPORT.
   ensure_port_free: String, Int => < | String >
   ensure_port_free = ip_str, port =>
      parse_ipv4(ip_str)
         | ip_addr =>
            err_msg = "Failed to bind to " + ip_str + ":" + str::from_int(port) + " (address already in use)"
            !probe_ipv4(ip_addr, port) | --| <- err_msg ->
            ip_addr != 0 && !probe_ipv4(0, port) | --| <- err_msg ->
            loopback_ip = 0x0100007F
            ip_addr == 0 && !probe_ipv4(loopback_ip, port) | --| <- err_msg ->
            (ip_addr == 0 || ip_addr == loopback_ip)
               |
                  (!probe_ipv6(port, <+>) || !probe_ipv6(port, <->)) | --| <- err_msg ->
            <++>
         | <- "Invalid IPv4 address: " + ip_str ->

   // Create a TCP listener with SO_REUSEADDR, SO_REUSEPORT, and TCP_NODELAY.
   // SO_REUSEPORT allows multiple worker processes/rings to bind the same port.
   create_listener: String, Int, Int => Conn
   create_listener = ip_str, port, backlog =>
      parse_ipv4(ip_str)
         | ip_addr =>
            sock = c_int(libc::socket(net::AF_INET, net::SOCK_STREAM, 0))
            sock < 0 | --| Conn(<- "Failed to create socket" +>)
            one = 1i32
            libc::setsockopt(sock, net::sol_socket!, net::so_reuseaddr!, &one, 4)
            libc::setsockopt(sock, net::sol_socket!, net::SO_REUSEPORT, &one, 4)
            libc::setsockopt(sock, net::IPPROTO_TCP, net::TCP_NODELAY, &one, 4)
            addr = SockAddrIn(net::sin_fam_inet!, u16(htons(port)), in_addr_u32(ip_addr), 0u64)
            bind_res = c_int(libc::bind(sock, &addr, 16))
            bind_res < 0
               |
                  libc::close(sock)
                  --| Conn(<- "Failed to bind to " + ip_str + ":" + str::from_int(port) +>)
            listen_res = c_int(libc::listen(sock, backlog))
            listen_res < 0
               |
                  libc::close(sock)
                  --| Conn(<- "Failed to listen on socket" +>)
            Conn(<+ sock ->)
         | Conn(<- "Invalid IPv4 address: " + ip_str +>)

   // Accept one incoming connection on server socket fd.
   // Returns Conn: <+ client fd +> on success, <- error -> on failure.
   tcp_accept: Int => Conn
   tcp_accept = server_fd =>
      s = c_int(libc::accept(server_fd, sys::addr_null, sys::addr_null))
      s [< 0] Conn(<- "accept failed" +>) | Conn(<+ s ->)

   // Send a string over a socket fd, looping until every byte is written:
   // send() may deliver fewer bytes than requested (partial send), and a call
   // that truncates would silently drop the tail of the message.
   send_str: Int, String => Int
   send_str = fd, msg =>
      off' = 0
      total = ?msg
      0.. @
         off' !< total | -->
         v = msg(off'..total)
         sent = libc::send(fd, v, ?v, 0)
         sent [< 1] -->
         off' = off' + sent
      off'

   // Receive up to n bytes into buf (a writable buffer) from fd. Returns bytes
   // received. buf is an Addr, not a String — a String is immutable and would
   // only ever hand a copy to the C write.
   recv_buf: Int, Addr, Int => Int
   recv_buf = fd, buf, n =>
      libc::recv(fd, buf, n, 0)

   // Receive up to max bytes from fd as a String (the read-side sibling of
   // send_str). Returns Chunk: <+ data +> on data, <--> on none/error.
   // One read;
   // does not loop.
   recv: Int, Int => Chunk
   recv = fd, max =>
      b = {max}
      n = libc::recv(fd, &b, max, 0)
      n [< 1] Chunk(<-->) |
         ?b = n
         Chunk(<+ +b +>)

   // Set the receive timeout on fd (ms). 0 clears it (block forever).
   set_recv_timeout: Int, Int => Int
   set_recv_timeout = fd, ms =>
      tv = Timeval(i64(ms / 1000),
         i64((ms % 1000) * 1000))
      libc::setsockopt(fd, net::sol_socket!, net::so_rcvtimeo!, &tv, 16)

   // Set the send timeout on fd (ms). 0 clears it.
   set_send_timeout: Int, Int => Int
   set_send_timeout = fd, ms =>
      tv = Timeval(i64(ms / 1000),
         i64((ms % 1000) * 1000))
      libc::setsockopt(fd, net::sol_socket!, net::so_sndtimeo!, &tv, 16)

   // Put fd in non-blocking mode (<+>) or back to blocking (<->).
   set_nonblocking: Int, <> => Int
   set_nonblocking = fd, flag =>
      flags = c_int(libc::fcntl(fd, net::F_GETFL, 0))
      flags [< 0] -1 |
         new_flags = flag | (flags .|. net::O_NONBLOCK) | (flags .&. .!. net::O_NONBLOCK)
         c_int(libc::fcntl(fd, net::F_SETFL, new_flags))

   // Disable (<+>) or enable (<->) Nagle's algorithm (TCP_NODELAY) on a TCP socket.
   set_nodelay: Int, <> => Int
   set_nodelay = fd, flag =>
      opt = flag | 1i32 | 0i32
      c_int(libc::setsockopt(fd, net::IPPROTO_TCP, net::TCP_NODELAY, &opt, 4))

   // Send FIN on fd without closing the read side.
   shutdown_fd: Int => Int
   shutdown_fd = fd =>
      libc::shutdown(fd, net::SHUT_WR)

   // Format IPv4 address as "a.b.c.d"
   ip_str: SockAddrIn => String
   ip_str = sa =>
      "${sa.sin_addr.b0}.${sa.sin_addr.b1}.${sa.sin_addr.b2}.${sa.sin_addr.b3}"

   // Format a SockAddrIn as "a.b.c.d:port"
   addr_str: SockAddrIn => String
   addr_str = sa =>
      "${ip_str(sa)}:${ntohs(Int(sa.sin_port))}"

   // The remote peer's address as "ip:port", or "" on error.
   peer_addr: Int => String
   peer_addr = fd =>
      a = SockAddrIn(0u16, 0u16, in_addr_any!, 0u64)
      len = 16i32
      ret = libc::getpeername(fd, &a, &len)
      ret [< 0] "" | net::addr_str(a)

   // This socket's own local address as "ip:port", or "" on error.
   local_addr: Int => String
   local_addr = fd =>
      a = SockAddrIn(0u16, 0u16, in_addr_any!, 0u64)
      len = 16i32
      ret = libc::getsockname(fd, &a, &len)
      ret [< 0] "" | net::addr_str(a)

   // Close a file descriptor.
   close_fd: Int => Int
   close_fd = fd =>
      libc::close $ fd

   // Create a UDP socket. Returns Conn: <+ fd +> on success, <- error -> on
   // failure. The unused arg keeps the signature callable (dva has no 0-arg
   // calls); it is not named "_" because predicate guards rebind "_". The local
   // is named "s" (not "fd") to dodge the flat-variable-map leak where a
   // top-level binding shadows a function-local of the same name.
   udp_socket: Int => Conn
   udp_socket = unused =>
      s = libc::socket(net::AF_INET, net::SOCK_DGRAM, net::IPPROTO_UDP)
      s [< 0] Conn(<- "socket failed" +>) | Conn(<+ s ->)

   // Bind a UDP socket to a port (0 = an ephemeral port chosen by the kernel).
   // Returns 0 on success, -1 on failure.
   udp_bind: Int, Int => Int
   udp_bind = fd, port =>
      addr = SockAddrIn(net::sin_fam_inet!,
         u16(htons $ port), in_addr_any!, 0u64)
      libc::bind(fd, &addr, 16)

   // Send one datagram to host:port (host must be a numeric IP). Returns the
   // number of bytes sent, or -1 on error.
   udp_send: Int, String, Int, String => Int
   udp_send = fd, host, port, data =>
      ip = libc::inet_addr $ host
      ip < 0 || ip == 0xFFFFFFFF
         | -1
         |
            addr = SockAddrIn(net::sin_fam_inet!,
               u16(htons $ port), in_addr_u32(ip), 0u64)
            libc::sendto(fd, data, ?data, 0, &addr, 16)

   // Receive one datagram. Returns Chunk: <+ data +> on data, <-->
   // on none/error.
   udp_recv: Int, Int => Chunk
   udp_recv = fd, max =>
      b = {max}
      n = libc::recvfrom(fd, &b, max, 0, sys::addr_null, sys::addr_null)
      n [< 1] Chunk(<-->) |
         ?b = n
         Chunk(<+ +b +>)

   // Match network interface from ifaddrs linked list by IP
   find_iface: Addr, InAddr => String
   find_iface = curr, target =>
      Int(curr) [0] "" |
         ifa = IfAddrs(curr)
         ifa.ifa_addr == sys::addr_null | find_iface(ifa.ifa_next, target) |
            sa = SockAddrIn(ifa.ifa_addr)
            fam = Int(sa.sin_family) .>. #! (os ["darwin"] 8 | 0)
            is_match = (fam == AF_INET) &&
               (sa.sin_addr.b0 == target.b0) && (sa.sin_addr.b1 == target.b1) &&
               (sa.sin_addr.b2 == target.b2) && (sa.sin_addr.b3 == target.b3)
            is_match
               | sys::c_str(ifa.ifa_name)
               | find_iface(ifa.ifa_next, target)

   // Query local routing IP and default outbound interface
   get_route_info: () => (String, String)
   get_route_info = !=>
      lo = #! (os ["darwin"] "lo0" | "lo")
      sock = libc::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP)
      sock [< 0] ("127.0.0.1", lo) |
         dest = SockAddrIn(net::sin_fam_inet!, u16(htons $ 53), InAddr(1u8, 1u8, 1u8, 1u8), 0u64)
         rc = libc::connect(sock, &dest, 16)
         rc [0]
            addr = SockAddrIn(0u16, 0u16, in_addr_any!, 0u64)
            len = 16i32
            rc2 = libc::getsockname(sock, &addr, &len)
            libc::close(sock)
            rc2 [0]
               ip = ip_str(addr)
               head_raw = 0
               rc_if = libc::getifaddrs(&head_raw)
               iface = rc_if [< 0] "" |
                  head = Addr(head_raw)
                  name = find_iface(head, addr.sin_addr)
                  libc::freeifaddrs(head)
                  name
               (ip, iface)
            | ("127.0.0.1", lo)
         |
            libc::close(sock)
            ("127.0.0.1", lo)

   // Get default local IPv4 address
   local_ip: () => String
   local_ip = !=>
      r = get_route_info!
      r.0

   // Get default outbound network interface
   default_interface: () => String
   default_interface = !=>
      r = get_route_info!
      r.1


