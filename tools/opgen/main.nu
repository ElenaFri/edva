#!/usr/bin/env nu
# tools/opgen/main.nu — generates the operator artifacts from operators.yaml
# (the single source of truth for every operator: symbol, tier, binding powers,
# associativity, operand/result types, description).
#
# Emits:
#   src/operators.dva the `bin_info` table
#   src/opvocab.dva   the `is_reserved_run` reserved-run vocabulary (leaf module)
#   GRAMMAR.md       the §1.6 operators/precedence table (between markers)
#
# Usage:
#   nu tools/opgen/main.nu            # write the artifacts in place
#   nu tools/opgen/main.nu --check    # verify the artifacts are in sync
#                                     # (exit 1 when out of date)

const SRC = "operators.yaml"
const DOC_MARKER_BEGIN = "<!-- BEGIN operators.yaml -->"
const DOC_MARKER_END = "<!-- END operators.yaml -->"

def root [] {
    ($env.FILE_PWD | path dirname | path dirname)
}

# -------- Selfhost: operators.dva -------------------------------------------

def gen_operators_file [] {
    let d = open ((root) | path join "operators.yaml")
    let lines = ($d.operators | where kind_self != null | each { |o|
        let t = ($d.tiers | where name == $o.tier | first)
        let sl = if $t.same_line { "<+>" } else { "<->" }
        let op = $"ast::BinaryOp\(($o.kind_self)\)"
        let info = $"BinOpInfo\(($t.lbp), ($t.rbp), ($op), ($sl)\)"
        $"      [\"($o.symbol)\"]  <+ ($info) +>"
    } | str join "\n")
    [
        "// src/operators.dva — the operator table. GENERATED by tools/opgen/main.nu",
        "// from operators.yaml — DO NOT EDIT; edit the YAML and rerun the generator.",
        "",
        "#use \"ast\"",
        "",
        "#public",
        "",
        "#type BinOpInfo (lbp: Int, rbp: Int, op: ast::BinaryOp, same_line: <>)",
        "",
        "// Returns the binary operator for a token's text, or none. Binding",
        "// powers follow operators.yaml (tier number * 10). The",
        "// comparison tier is same-line: only one comparison may chain",
        "// operators across a newline.",
        "bin_info: String => < BinOpInfo | >",
        "bin_info = text =>",
        "   text",
        $lines,
        "      | <-->",
        "",
    ] | str join "\n"
}

# -------- Selfhost: opvocab.dva ---------------------------------------------

# The reserved operator-run vocabulary: the union of the binary operator
# symbols (rows with a kind_self) and the fixed sigil forms. Emitted into a
# leaf module so the lexer layer can consume it without depending on `ast`.
def gen_opvocab_file [] {
    let d = open ((root) | path join "operators.yaml")
    let symbols = ($d.operators | where kind_self != null | get symbol)
    let all = ($symbols | append $d.sigils | uniq)
    let quoted = ($all | each { |s| $'"($s)"' })
    let groups = ($quoted | chunks 8)
    let last = (($groups | length) - 1)
    let body = ($groups | enumerate | each { |row|
        let prefix = if $row.index == 0 { "      [" } else { "       " }
        let suffix = if $row.index == $last { "]" } else { "," }
        $prefix + ($row.item | str join ", ") + $suffix
    } | str join "\n")
    [
        "// src/opvocab.dva — the reserved operator-run vocabulary. GENERATED by",
        "// tools/opgen/main.nu from operators.yaml — DO NOT EDIT; edit the YAML",
        "// and rerun the generator.",
        "//",
        "// A special-character run OUTSIDE this set is a legal user-defined operator",
        "// name ('#infix'); a run INSIDE it is reserved (parser pstate op_is_reserved,",
        "// E2097). The set is the union of the binary operator symbols (bin_info) and",
        "// the fixed sigil forms (ram literals, cycle jumps, assignment, member/key",
        "// access, early return, call forms). This module is a leaf: it imports",
        "// nothing, so the lexer layer can consume it without pulling in `ast`.",
        "",
        "#public",
        "",
        "// Whether an operator run belongs to the reserved vocabulary.",
        "is_reserved_run: String => <>",
        "is_reserved_run = text =>",
        "   text",
        $body,
        "",
    ] | str join "\n"
}

# -------- Docs: GRAMMAR.md §1.6 --------------------------------------------

def gen_doc_block [] {
    let d = open ((root) | path join "operators.yaml")
    let rows = ($d.tiers | each { |t|
        let ops = (
            $d.operators | where tier == $t.name | get symbol
            | each { |s| $"`($s)`" } | str join " "
        )
        let assoc = if $t.assoc == "right" { "right" } else { "left" }
        let same = if $t.same_line { ", same-line" } else { "" }
        $"| ($t.name) | ($t.lbp) | ($t.rbp) | ($ops) | ($assoc)($same) |"
    } | str join "\n")
    [
        $DOC_MARKER_BEGIN,
        "| Tier | LBP | RBP | Operators | Associativity |",
        "|---|---|---|---|---|",
        $rows,
        "",
        $DOC_MARKER_END,
    ] | str join "\n"
}

# -------- helpers ----------------------------------------------------------

def replace_block [content: string, marker_begin: string, marker_end: string, replacement: string] {
    let start = ($content | str index-of $marker_begin)
    let end = ($content | str index-of $marker_end)
    if $start < 0 or $end < 0 {
        error make { msg: $"markers not found: ($marker_begin) / ($marker_end)" }
    }
    let before = ($content | str substring 0..<$start)
    let after_start = $end + ($marker_end | str length)
    let after = ($content | str substring $after_start..)
    $before + $replacement + $after
}

def artifact_operators [] {
    gen_operators_file
}

def artifact_opvocab [] {
    gen_opvocab_file
}

def artifact_doc [content: string] {
    replace_block $content $DOC_MARKER_BEGIN $DOC_MARKER_END (gen_doc_block)
}

# -------- main -------------------------------------------------------------

def main [--check] {
    let root_dir = (root)
    let operators_path = ($root_dir | path join "src/operators.dva")
    let opvocab_path = ($root_dir | path join "src/opvocab.dva")
    let doc_path = ($root_dir | path join "GRAMMAR.md")
    let llms_path = ($root_dir | path join "doc/llms.txt")
    let llms_full_path = ($root_dir | path join "doc/llms-full.txt")
    let quarto_path = ($root_dir | path join "doc/reference/language/operators.qmd")

    let operators_new = (artifact_operators)
    let opvocab_new = (artifact_opvocab)
    let doc_new = (artifact_doc (open --raw $doc_path))
    let llms_new = (artifact_doc (open --raw $llms_path))
    let llms_full_new = (artifact_doc (open --raw $llms_full_path))
    let quarto_new = (artifact_doc (open --raw $quarto_path))

    if $check {
        let operators_ok = (
            ($operators_new | str trim) == ((open --raw $operators_path) | str trim)
        )
        let opvocab_ok = (
            ($opvocab_new | str trim) == ((open --raw $opvocab_path) | str trim)
        )
        let doc_new_raw = (open --raw $doc_path)
        let doc_ok = (($doc_new | str trim) == ($doc_new_raw | str trim))
        let llms_new_raw = (open --raw $llms_path)
        let llms_ok = (($llms_new | str trim) == ($llms_new_raw | str trim))
        let llms_full_new_raw = (open --raw $llms_full_path)
        let llms_full_ok = (($llms_full_new | str trim) == ($llms_full_new_raw | str trim))
        let quarto_new_raw = (open --raw $quarto_path)
        let quarto_ok = (($quarto_new | str trim) == ($quarto_new_raw | str trim))

        if not $operators_ok {
            print "operators.yaml: src/operators.dva out of sync — run 'nu tools/opgen/main.nu'."
        }
        if not $opvocab_ok {
            print "operators.yaml: src/opvocab.dva out of sync — run 'nu tools/opgen/main.nu'."
        }
        if not $doc_ok {
            print "operators.yaml: GRAMMAR.md table out of sync — run 'nu tools/opgen/main.nu'."
        }
        if not $llms_ok {
            print "operators.yaml: doc/llms.txt table out of sync — run 'nu tools/opgen/main.nu'."
        }
        if not $llms_full_ok {
            print "operators.yaml: doc/llms-full.txt out of sync — run 'nu tools/opgen/main.nu'."
        }
        if not $quarto_ok {
            print "operators.yaml: operators.qmd out of sync — run 'nu tools/opgen/main.nu'."
        }
        let any_failed = (
            (not $operators_ok) or (not $opvocab_ok) or (not $doc_ok) or
            (not $llms_ok) or (not $llms_full_ok) or (not $quarto_ok)
        )
        if $any_failed {
            exit 1
        }
        print "operators.yaml: all artifacts in sync."
    } else {
        $operators_new | save -f $operators_path
        $opvocab_new | save -f $opvocab_path
        $doc_new | save -f $doc_path
        $llms_new | save -f $llms_path
        $llms_full_new | save -f $llms_full_path
        $quarto_new | save -f $quarto_path
        print "operators.yaml: regenerated operators.dva, opvocab.dva, GRAMMAR.md, llms, operators.qmd."
    }
}